# Database (required)
# For local development
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# Nominatim database (required for reverse geocoding)
NOMINATIM_DATABASE_URL=postgresql://nominatim:nominatim@10.96.0.4:5432/nominatim

# For Docker Compose
# DATABASE_URL=postgresql://geocode:geocode@postgres:5432/geocode

# Server (optional)
PORT=3000
HOST=0.0.0.0

# Hierarchical Import Options
# Import single country (optional - if not set, imports all ~250 countries)
# COUNTRY_CODE=BEL

# Admin level range (required)
ADMIN_LEVEL_START=2
ADMIN_LEVEL_END=11
